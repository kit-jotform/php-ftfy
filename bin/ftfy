#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Ftfy\Ftfy;

// Parse flags
$explain      = false;
$needsFix     = false;
$jsonMode     = false;
$file         = null;
$configArgs   = [];
$args         = [];

for ($i = 1; $i < $argc; $i++) {
    switch ($argv[$i]) {
        case '--explain':
        case '-e':
            $explain = true;
            break;
        case '--needs-fix':
        case '-n':
            $needsFix = true;
            break;
        case '--json':
        case '-j':
            $jsonMode = true;
            break;
        case '--file':
        case '-f':
            $file = $argv[++$i] ?? null;
            break;
        case '--config':
        case '-c':
            $pair = $argv[++$i] ?? null;
            if ($pair === null || !str_contains($pair, '=')) {
                fwrite(STDERR, "ftfy: --config requires a key=value argument\n");
                exit(1);
            }
            [$key, $val] = explode('=', $pair, 2);
            $configArgs[$key] = $val;
            break;
        case '--help':
        case '-h':
            help();
            break;
        default:
            $args[] = $argv[$i];
    }
}

// Build config from --config overrides
$config = buildConfig($configArgs);

// Get input: argument > file > stdin
if ($args) {
    $text = implode(' ', $args);
} elseif ($file !== null) {
    $text = file_get_contents($file);
    if ($text === false) {
        fwrite(STDERR, "ftfy: cannot read file: $file\n");
        exit(1);
    }
} elseif (!posix_isatty(STDIN)) {
    $text = stream_get_contents(STDIN);
} else {
    help();
}

if ($jsonMode) {
    if ($needsFix) {
        $needs = jsonNeedsFix($text, $config);
        echo ($needs ? 'true' : 'false') . "\n";
        exit($needs ? 1 : 0);
    }
    if ($explain) {
        [$fixed, $plan] = fixJsonInPlace($text, $config, explain: true);
        echo $fixed;
        if ($plan) {
            fwrite(STDERR, "\nexplanation:\n");
            foreach ($plan as [$operation, $param]) {
                fwrite(STDERR, "  - $operation: $param\n");
            }
        }
        exit(0);
    }
    echo fixJsonInPlace($text, $config);
    exit(0);
}

if ($needsFix) {
    $needs = Ftfy::needsFix($text, $config);
    echo ($needs ? 'true' : 'false') . "\n";
    exit($needs ? 1 : 0);
}

if ($explain) {
    [$fixed, $plan] = Ftfy::fixAndExplain($text, $config);
    echo $fixed . "\n";
    if ($plan) {
        fwrite(STDERR, "\nexplanation:\n");
        foreach ($plan as [$operation, $param]) {
            fwrite(STDERR, "  - $operation: $param\n");
        }
    }
} else {
    echo Ftfy::fixText($text, $config) . "\n";
}

function help(): never
{
    echo <<<HELP
    Usage:
      ftfy [options] "text to fix"
      ftfy [options] --file input.txt
      echo "text" | ftfy [options]

    Options:
      -e, --explain          Print what was fixed (to stderr)
      -n, --needs-fix        Print true/false; exit 0 if no fix needed, 1 if fix needed
      -j, --json             Fix mojibake inside JSON string values (minimal-diff output)
      -f, --file             Read input from a file
      -c, --config key=val   Set a TextFixerConfig option (repeatable)
      -h, --help             Show this help

    Config keys (bool options accept true/false/1/0):
      uncurlQuotes, fixEncoding, fixLineBreaks, fixSurrogates,
      removeControlChars, removeTerminalEscapes, restoreByteA0,
      replaceLossySequences, decodeInconsistentUtf8, fixC1Controls,
      fixLatinLigatures, fixCharacterWidth, unescapeHtml,
      normalization, maxDecodeLength

    Examples:
      ftfy -c uncurlQuotes=false "input"
      ftfy -c normalization=NFKC -c fixLineBreaks=false --file in.txt

    HELP;
    exit(0);
}

function buildConfig(array $configArgs): \Ftfy\TextFixerConfig
{
    $boolKeys = [
        'removeTerminalEscapes', 'fixEncoding', 'restoreByteA0',
        'replaceLossySequences', 'decodeInconsistentUtf8', 'fixC1Controls',
        'fixLatinLigatures', 'fixCharacterWidth', 'uncurlQuotes',
        'fixLineBreaks', 'fixSurrogates', 'removeControlChars',
    ];

    $overrides = [];
    foreach ($configArgs as $key => $val) {
        if (in_array($key, $boolKeys, true)) {
            $overrides[$key] = filter_var($val, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE);
            if ($overrides[$key] === null) {
                fwrite(STDERR, "ftfy: config '$key' expects a boolean value (true/false/1/0), got: $val\n");
                exit(1);
            }
        } elseif ($key === 'unescapeHtml') {
            if ($val === 'auto') {
                $overrides[$key] = 'auto';
            } else {
                $overrides[$key] = filter_var($val, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE);
                if ($overrides[$key] === null) {
                    fwrite(STDERR, "ftfy: config 'unescapeHtml' expects auto/true/false/1/0, got: $val\n");
                    exit(1);
                }
            }
        } elseif ($key === 'normalization') {
            $overrides[$key] = $val === 'null' ? null : $val;
        } elseif ($key === 'maxDecodeLength') {
            $overrides[$key] = (int) $val;
        } else {
            fwrite(STDERR, "ftfy: unknown config key: $key\n");
            exit(1);
        }
    }

    return (new \Ftfy\TextFixerConfig())->with(...$overrides);
}

/**
 * Walk JSON byte-by-byte, fix mojibake inside string literals, and emit
 * the original bytes verbatim everywhere else. No regex (avoids PCRE
 * backtrack/recursion limits on large inputs). No json_decode round-trip
 * on the whole document.
 *
 * Only strings containing \u00XX escapes (the byte range that produces
 * Windows-1252 mojibake) are decoded and tested with Ftfy::needsFix; all
 * other strings — and all non-string bytes — pass through unchanged.
 *
 * When $explain is true, returns [output, mergedPlan] where mergedPlan
 * is the de-duplicated list of operations applied across all strings.
 *
 * @return string|array{0:string,1:list<array{0:string,1:mixed}>}
 */
function fixJsonInPlace(string $json, \Ftfy\TextFixerConfig $config, bool $explain = false): string|array
{
    $out = '';
    $len = strlen($json);
    $i = 0;
    $mergedPlan = [];
    $seenOps = [];

    if ($explain) {
        $config = $config->with(explain: true);
    }

    while ($i < $len) {
        $ch = $json[$i];

        if ($ch !== '"') {
            $out .= $ch;
            $i++;
            continue;
        }

        // Found opening quote: scan to the matching close quote.
        $start = $i;
        $i++; // skip opening "
        $hasLowUnicodeEscape = false;

        while ($i < $len) {
            $b = $json[$i];
            if ($b === '\\') {
                // Note a \u00XX escape: produces a byte in 0x00-0xFF, where
                // 0x80-0xFF is where mojibake lives.
                if (!$hasLowUnicodeEscape
                    && $i + 3 < $len
                    && $json[$i + 1] === 'u'
                    && $json[$i + 2] === '0'
                    && $json[$i + 3] === '0'
                ) {
                    $hasLowUnicodeEscape = true;
                }
                $i += 2; // skip backslash + next byte (covers \", \\, \uXXXX prefix)
                continue;
            }
            if ($b === '"') {
                $i++; // include closing "
                break;
            }
            $i++;
        }

        $literal = substr($json, $start, $i - $start);

        // Fast path: no \u00XX escape means no possible mojibake.
        if (!$hasLowUnicodeEscape) {
            $out .= $literal;
            continue;
        }

        // Decode just this string's escapes via json_decode (no recursion).
        $decoded = json_decode($literal);
        if (!is_string($decoded) || !\Ftfy\Ftfy::needsFix($decoded, $config)) {
            $out .= $literal;
            continue;
        }

        if ($explain) {
            [$fixed, $plan] = \Ftfy\Ftfy::fixAndExplain($decoded, $config);
            foreach ($plan as $step) {
                $key = $step[0] . "\0" . (is_scalar($step[1]) ? (string) $step[1] : '');
                if (!isset($seenOps[$key])) {
                    $seenOps[$key] = true;
                    $mergedPlan[] = $step;
                }
            }
        } else {
            $fixed = \Ftfy\Ftfy::fixText($decoded, $config);
        }

        // Re-encode with the same flags used by the source: keep real Unicode
        // characters (UNESCAPED_UNICODE) and keep slashes as-is.
        $reencoded = json_encode($fixed, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        $out .= ($reencoded === false) ? $literal : $reencoded;
    }

    return $explain ? [$out, $mergedPlan] : $out;
}

/**
 * Same scanner as fixJsonInPlace but short-circuits on the first string
 * that needs fixing. O(prefix) instead of O(file).
 */
function jsonNeedsFix(string $json, \Ftfy\TextFixerConfig $config): bool
{
    $len = strlen($json);
    $i = 0;

    while ($i < $len) {
        if ($json[$i] !== '"') {
            $i++;
            continue;
        }

        $start = $i;
        $i++;
        $hasLowUnicodeEscape = false;

        while ($i < $len) {
            $b = $json[$i];
            if ($b === '\\') {
                if (!$hasLowUnicodeEscape
                    && $i + 3 < $len
                    && $json[$i + 1] === 'u'
                    && $json[$i + 2] === '0'
                    && $json[$i + 3] === '0'
                ) {
                    $hasLowUnicodeEscape = true;
                }
                $i += 2;
                continue;
            }
            if ($b === '"') {
                $i++;
                break;
            }
            $i++;
        }

        if (!$hasLowUnicodeEscape) {
            continue;
        }

        $decoded = json_decode(substr($json, $start, $i - $start));
        if (is_string($decoded) && \Ftfy\Ftfy::needsFix($decoded, $config)) {
            return true;
        }
    }

    return false;
}
